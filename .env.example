GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
FRONTEND_URL=http://localhost:3001

UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

YTMUSIC_PORT=8001

# Python ytmusicapi service (services/ytmusic-python). Optional: Wave works
# without it; /api/ytmusic-py/* returns controlled errors when unreachable.
YTMUSIC_PY_URL=http://127.0.0.1:8002
YTMUSIC_PY_PORT=8002
YTMUSIC_PY_SECRET=change-me-in-production
# Legacy alias also accepted by the Python service (either name works).
# YT_PY_SECRET=change-me-in-production
YTMUSIC_PY_TIMEOUT_MS=8000