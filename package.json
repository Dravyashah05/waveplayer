{
  "name": "wave-player",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "homepage": "https://github.com/Dravyashah05/waveplayer#readme",
  "bugs": {
    "url": "https://github.com/Dravyashah05/waveplayer/issues"
